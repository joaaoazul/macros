# Copia para .env e preenche. Gera segredos com: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Email (Resend) — vazio desativa verificação de email e reset de password
RESEND_API_KEY=
EMAIL_FROM=Macros <macros@joaoazul.dev>

APP_URL=https://macros.joaoazul.dev
COOKIE_SECURE=true

# Backups da base de dados — ver docs/BACKUPS.md.
# Destino rclone. Vazio = a cópia fica só no VPS (ou seja, não é backup).
BACKUP_REMOTE=b2:macros-backups/db
# Cifra o dump antes de sair da máquina. Gera com: openssl rand -base64 32
# GUARDA-A FORA DO VPS — sem ela os backups não se restauram.
BACKUP_PASSPHRASE=
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE_DAYS=90

# App Android (Capacitor) — ver a secção Android do README.
# Origem absoluta da API usada pela build nativa (os assets do APK correm em
# https://localhost, por isso a API deixa de ser same-origin). Tem de ser HTTPS.
VITE_API_ORIGIN=https://macros.joaoazul.dev
# Origens do shell nativo aceites pelo backend em CORS e no WebSocket.
# Só mexer se mudares o `server.hostname` do capacitor.config.ts.
# NATIVE_ORIGINS=["https://localhost"]
